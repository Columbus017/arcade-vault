# Resend API key (server-only, never prefix with NEXT_PUBLIC_)
RESEND_API_KEY=
# Inbox that receives contact messages.
# With the default onboarding@resend.dev sender, Resend only delivers to the Resend account's own email.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=onboarding@resend.dev
#SUPABASE
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_DB_PASSWORD=